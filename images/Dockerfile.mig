# CARI Issue 2 - migration job. The current server is Redis 7.2.16 (last BSD release, from the official
# image); the new server is the target product's official image.
#   valkey: BASE=valkey/valkey:9.1.2-trixie
#   redis:  BASE=redis:8.10.2-trixie
ARG BASE
FROM redis:7.2.16@sha256:0637954999d01b7c9ce9167db2da50656e2590d3b884f1c600c5f63bb6e6773c AS old
FROM ${BASE}
ARG PRODUCT
USER root
ENV DEBIAN_FRONTEND=noninteractive PIP_BREAK_SYSTEM_PACKAGES=1 PIP_DISABLE_PIP_VERSION_CHECK=1 KV_PRODUCT=${PRODUCT}
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv ca-certificates curl jq procps less vim-tiny iproute2 net-tools \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /bin/bash /bin/sh
RUN pip3 install --no-cache-dir redis==8.1.0 valkey==6.1.1 && pip3 list --format=json > /opt/pip-system.json
RUN python3 -m venv /opt/kv-grader && /opt/kv-grader/bin/pip install --no-cache-dir redis==8.1.0 \
    && /opt/kv-grader/bin/pip list --format=json > /opt/pip-grader.json
COPY --from=old /usr/local/bin/redis-server /opt/redis-7.2/bin/redis-server
COPY --from=old /usr/local/bin/redis-cli /opt/redis-7.2/bin/redis-cli
RUN /opt/redis-7.2/bin/redis-server --version
COPY assets/mig/old.conf /etc/redis-old/redis.conf
COPY assets/mig/${PRODUCT}.conf /etc/${PRODUCT}/${PRODUCT}.conf
COPY assets/mig/seed_old.py assets/mig/kvdump.py /opt/kv-seed/
COPY --chmod=0755 assets/kv-start-mig.sh /usr/local/sbin/kv-start
WORKDIR /root
ENTRYPOINT []
CMD ["/usr/local/sbin/kv-start"]
